# /srv/apps/shop-tools/.env (mode 600, owner deploy; never commit the real one).
# deploy-app changes only the IMAGE_TAG line (the commit SHA to run).
# Generate each secret with: openssl rand -hex 32
IMAGE_TAG=none
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# admin sign-in for the live demo (12+ characters, keep private); the email is optional
ADMIN_PASSWORD=
# ADMIN_EMAIL=admin@shop-tools.local
