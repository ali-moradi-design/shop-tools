// MySQL schema. Money is stored as integers in minor units (cents).
// Arrays of plain strings (images, tags, features) are JSON columns: MySQL has no array type.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  pending_payment
  paid
  processing
  shipped
  completed
  cancelled
  failed
}

enum PaymentStatus {
  pending
  paid
  failed
}

enum DiscountType {
  percent
  fixed
}

enum IssueType {
  product
  order
  review
  other
}

enum IssueStatus {
  open
  in_progress
  resolved
  closed
}

// ---------- identity ----------

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  roles         UserRole[]
  refreshTokens RefreshToken[]
  orders        Order[]
  reviews       Review[]
  favorites     Favorite[]
  issueReports  IssueReport[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  section     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RefreshToken {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedByHash String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

// ---------- catalog ----------

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String? @db.Text
  sortOrder   Int     @default(0)

  products Product[]
  specs    SpecDefinition[]
}

enum SpecKind {
  number
  text
}

/// One technical specification a category has (e.g. "Torque" for drills).
/// Numbers are stored in the base unit (`unit`); `unitFamily` says which other units exist.
model SpecDefinition {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key        String
  label      String
  /// Heading in the specs table ("Performance", "Battery", ...).
  group      String
  kind       SpecKind
  unit       String?
  unitFamily String?
  filterable Boolean  @default(true)
  /// For "best value" in the compare table: "higher" or "lower"; null = no ranking.
  better     String?
  sortOrder  Int      @default(0)

  values ProductSpec[]

  @@unique([categoryId, key])
}

/// The value of one specification for one product (entity-attribute-value).
/// Numbers live in `valueNum` (indexed for range filters), words in `valueText`.
model ProductSpec {
  id        String         @id @default(cuid())
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  specId    String
  spec      SpecDefinition @relation(fields: [specId], references: [id], onDelete: Cascade)
  valueNum  Float?
  valueText String?

  @@unique([productId, specId])
  @@index([specId, valueNum])
  @@index([specId, valueText])
}

model Warehouse {
  id        String @id @default(cuid())
  code      String @unique
  name      String
  city      String
  /// Lower = used first when an order is shipped.
  sortOrder Int    @default(0)

  stock       StockLevel[]
  allocations OrderItemAllocation[]
}

model Product {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  brand          String    @default("")
  model          String?
  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id])
  description    String    @db.Text
  features       Json
  price          Int
  compareAtPrice Int?
  currency       String    @default("USD")
  images         Json
  tags           Json
  /// Sum of the stock of every variant in every warehouse, kept in sync in the same transaction.
  stock          Int       @default(0)
  featured       Boolean   @default(false)
  featuredOrder  Int       @default(0)
  ratingAvg      Float     @default(0)
  ratingCount    Int       @default(0)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  variants   ProductVariant[]
  specs      ProductSpec[]
  orderItems OrderItem[]
  cartItems  CartItem[]
  reviews    Review[]
  favorites  Favorite[]

  @@index([categoryId, featuredOrder])
  @@index([featured, featuredOrder])
  @@index([price])
  @@index([stock])
}

/// A sellable option of a product (for example "Body only" or "2 x 4.0 Ah kit").
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String  @unique
  label     String
  /// Overrides the product price when set (a kit costs more than the bare tool).
  price     Int?
  position  Int     @default(0)

  stock StockLevel[]

  @@index([productId])
}

/// Units of one variant on the shelf of one warehouse.
model StockLevel {
  warehouseId String
  variantId   String
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity    Int            @default(0)

  @@id([warehouseId, variantId])
  @@index([variantId])
}

model Discount {
  id             String       @id @default(cuid())
  code           String       @unique
  type           DiscountType
  value          Int
  minOrderAmount Int?
  maxUses        Int?
  usedCount      Int          @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean      @default(true)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ---------- ordering ----------

model Cart {
  id        String     @id @default(cuid())
  /// `user:<id>` or `guest:<uuid>`
  owner     String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  @@index([updatedAt])
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String
  quantity  Int
  position  Int     @default(0)

  @@unique([cartId, productId, sku])
  @@index([productId])
}

model Order {
  id                 String        @id @default(cuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  subtotalAmount     Int
  discountCode       String?
  discountAmount     Int           @default(0)
  totalAmount        Int
  status             OrderStatus   @default(pending_payment)
  paymentMethod      String        @default("fake")
  paymentStatus      PaymentStatus @default(pending)
  paidAt             DateTime?
  transactionId      String?
  shippingFullName   String
  shippingLine1      String
  shippingLine2      String?
  shippingCity       String
  shippingState      String?
  shippingPostalCode String
  shippingCountry    String
  deletedAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  items   OrderItem[]
  history OrderStatusHistory[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([paidAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  sku       String
  label     String
  title     String
  image     String? @db.Text
  price     Int
  quantity  Int
  position  Int     @default(0)

  allocations OrderItemAllocation[]

  @@index([orderId])
  @@index([productId])
}

/// Which warehouse the units of an order line were taken from when it was paid.
model OrderItemAllocation {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  quantity    Int

  @@index([orderItemId])
  @@index([warehouseId])
}

model OrderStatusHistory {
  id      String      @id @default(cuid())
  orderId String
  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status  OrderStatus
  at      DateTime    @default(now())
  note    String?     @db.Text

  @@index([orderId])
}

// ---------- engagement, reviews, reporting ----------

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId])
}

model Review {
  id        String    @id @default(cuid())
  productId String
  userId    String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?   @db.Text
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([productId, createdAt])
  @@index([userId])
}

model IssueReport {
  id         String      @id @default(cuid())
  reporterId String
  reporter   User        @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  type       IssueType
  targetId   String?
  subject    String
  body       String      @db.Text
  status     IssueStatus @default(open)
  adminNotes String?     @db.Text
  deletedAt  DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([reporterId])
  @@index([status])
}
