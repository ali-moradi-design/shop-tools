PORT=4000
# MySQL (docker compose up -d); apply the schema with `pnpm migrate`
DATABASE_URL=mysql://root:root@127.0.0.1:3306/toolbench
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
NODE_ENV=development
# Explicit frontend origin (required for cookie auth). Do not use * in production
# when credentials are enabled — browsers reject Access-Control-Allow-Origin: *.
# Comma-separated list is allowed. If set to *, the API reflects the request
# origin in development/test only.
CORS_ORIGIN=http://localhost:3000
# Proxies in front of the API (the storefront's /api route = 1).
# Needed so rate limits count visitors, not the storefront server.
TRUST_PROXY=0
UPLOAD_DIR=uploads
# Cookie flags for accessToken / refreshToken (httpOnly always).
# COOKIE_SECURE defaults to true in production and false in development/test.
COOKIE_SECURE=false
# lax | strict | none  (none requires COOKIE_SECURE=true and HTTPS)
COOKIE_SAME_SITE=lax
# Optional; omit unless the API is served on a parent domain of the frontend.
# COOKIE_DOMAIN=
# Nightly demo reset (pnpm reset-demo) clears the storefront cache through this hook.
# WEB_REVALIDATE_URL=http://localhost:3000/hooks/revalidate
# REVALIDATE_SECRET=change-me
# Seed admin (required in production, 12+ characters)
# ADMIN_EMAIL=admin@shop-tools.local
# ADMIN_PASSWORD=
